[Unit]
Description=rw-backup-verify worker (queue drain)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=RBV_CONFIG=/etc/rw-backup-verify/config.json
Environment=RBV_INSTALL_DIR=/opt/rw-backup-verify
ExecStart=/opt/rw-backup-verify/bin/rw-backup-verify tick
Nice=10

[Install]
WantedBy=multi-user.target
