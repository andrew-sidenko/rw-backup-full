#!/usr/bin/env bash
# Главный CLI: rw-backup-verify <команда> ...
set -euo pipefail
# Через /usr/local/bin симлинк dirname(BASH_SOURCE)=/usr/local/bin → нужен realpath.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
COMMON="${ROOT}/lib/common.sh"
# Запасной путь на случай копирования бинаря без дерева (install.sh ставит в /opt).
if [[ ! -f "$COMMON" ]]; then
  COMMON="${RBV_INSTALL_DIR:-/opt/rw-backup-verify}/lib/common.sh"
fi
if [[ ! -f "$COMMON" ]]; then
  echo "[ERR] Не найден common.sh (ожидали ${ROOT}/lib/common.sh). Переустановите: sudo ./install.sh" >&2
  exit 1
fi
# shellcheck source=../lib/common.sh
source "$COMMON"

usage() {
  cat <<'EOF'
rw-backup-verify — автономная проверка логических бэкапов в S3

  storage list|show|add|remove
  telegram|tel|tg set|show
  schedule show|set --times HH:MM,HH:MM | --interval-hours N

  discover <storage-id> [--all]     # deep; по умолчанию только untested
  run [--due]                       # все хранилища: discover untested → очередь → work
  run --storage ID                  # только одно хранилище
  queue status|clear|work
  tick                              # systemd: если глобально due → run

Глубокий обход: любые вложенные папки; в каждой — экземпляры panel/bot
(по семейству имён). Тестируется только latest каждого экземпляра,
если этот архив ещё не был в tested/.
EOF
}

cmd="${1:-}"
[[ -n "$cmd" ]] || { usage; exit 1; }
shift || true

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
esac

if [[ ! -f "$RBV_CONFIG" ]]; then
  if [[ "$cmd" == "init" ]]; then
    mkdir -p "$(dirname "$RBV_CONFIG")"
    cp "${ROOT}/config/config.example.json" "$RBV_CONFIG"
    chmod 600 "$RBV_CONFIG"
    msg OK "Создан $RBV_CONFIG"
    exit 0
  fi
  msg ERR "Нет $RBV_CONFIG — сначала: sudo rw-backup-verify init (или install.sh)"
  exit 1
fi

rbv_load_config

case "$cmd" in
  init) msg INFO "Конфиг уже есть: $RBV_CONFIG" ;;

  storage)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list)
        jq -r '.storages[] | "\(.id)\tbucket=\(.bucket)\tprefix=\(.prefix // "")\thint=\(.backup_hint // "")"' \
          "$RBV_CONFIG"
        ;;
      show)
        id="${1:?id}"
        rbv_storage_json "$id" | jq .
        ;;
      remove)
        id="${1:?id}"
        jq --arg id "$id" 'del(.storages[] | select(.id==$id))' "$RBV_CONFIG" | rbv_save_config
        msg OK "Удалено: $id"
        ;;
      add)
        ID=""; EP=""; BUCKET=""; AK=""; SK=""; REGION="us-east-1"
        PREFIX=""; HINT=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --id) ID="$2"; shift 2 ;;
            --endpoint) EP="$2"; shift 2 ;;
            --bucket) BUCKET="$2"; shift 2 ;;
            --access-key) AK="$2"; shift 2 ;;
            --secret-key) SK="$2"; shift 2 ;;
            --region) REGION="$2"; shift 2 ;;
            --prefix) PREFIX="$2"; shift 2 ;;
            --backup-hint) HINT="$2"; shift 2 ;;
            --times|--interval-hours|--categories)
              msg WARN "$1 устарел: расписание теперь глобальное (schedule set); категории — авто deep-scan"
              shift 2 ;;
            *) msg ERR "unknown $1"; exit 1 ;;
          esac
        done
        [[ -n "$ID" && -n "$BUCKET" && -n "$AK" && -n "$SK" ]] \
          || { msg ERR "--id --bucket --access-key --secret-key обязательны"; exit 1; }
        entry="$(jq -nc \
          --arg id "$ID" --arg ep "$EP" --arg b "$BUCKET" \
          --arg ak "$AK" --arg sk "$SK" --arg r "$REGION" --arg p "$PREFIX" \
          --arg hint "$HINT" \
          '{id:$id, endpoint:$ep, bucket:$b, access_key:$ak, secret_key:$sk,
            region:$r, prefix:$p, backup_hint:$hint, telegram:{}}')"
        jq --argjson e "$entry" '
          .storages = ([.storages[] | select(.id != $e.id)] + [$e])
        ' "$RBV_CONFIG" | rbv_save_config
        msg OK "Хранилище ${ID} сохранено"
        ;;
      *) msg ERR "storage: list|show|add|remove"; exit 1 ;;
    esac
    ;;

  schedule)
    sub="${1:-show}"; shift || true
    case "$sub" in
      show)
        jq '.verify // {interval_hours:12}' "$RBV_CONFIG"
        ;;
      set)
        TIMES=""; INTERVAL=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --times) TIMES="$2"; shift 2 ;;
            --interval-hours) INTERVAL="$2"; shift 2 ;;
            *) msg ERR "unknown $1"; exit 1 ;;
          esac
        done
        if [[ -n "$INTERVAL" ]]; then
          [[ "$INTERVAL" =~ ^[1-9][0-9]*$ ]] \
            || { msg ERR "--interval-hours: целое число > 0"; exit 1; }
          jq --argjson h "$INTERVAL" '.verify={interval_hours:$h}' "$RBV_CONFIG" | rbv_save_config
        elif [[ -n "$TIMES" ]]; then
          IFS=',' read -ra _times <<<"$TIMES"
          ((${#_times[@]} > 0)) || { msg ERR "--times: пусто"; exit 1; }
          for t in "${_times[@]}"; do
            [[ "$t" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] \
              || { msg ERR "--times: ожидается HH:MM (00–23:59), плохое значение: ${t}"; exit 1; }
          done
          jq --arg s "$TIMES" '.verify={times:($s|split(","))}' "$RBV_CONFIG" | rbv_save_config
        else
          msg ERR "нужен --times или --interval-hours"; exit 1
        fi
        msg OK "Глобальное расписание сохранено"
        jq '.verify' "$RBV_CONFIG"
        ;;
      *) msg ERR "schedule: show|set"; exit 1 ;;
    esac
    ;;

  telegram|tel|tg)
    sub="${1:-show}"; shift || true
    case "$sub" in
      show) jq '.telegram' "$RBV_CONFIG" ;;
      set)
        TOK=""; CHAT=""; THR=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --token) TOK="$2"; shift 2 ;;
            --chat-id) CHAT="$2"; shift 2 ;;
            --thread-id) THR="$2"; shift 2 ;;
            *) msg ERR "unknown $1"; exit 1 ;;
          esac
        done
        [[ -n "$TOK" && -n "$CHAT" ]] || { msg ERR "--token и --chat-id"; exit 1; }
        jq --arg t "$TOK" --arg c "$CHAT" --arg h "$THR" \
          '.telegram.token=$t | .telegram.chat_id=$c | .telegram.thread_id=$h' \
          "$RBV_CONFIG" | rbv_save_config
        msg OK "Telegram сохранён"
        ;;
      *) msg ERR "telegram: show|set"; exit 1 ;;
    esac
    ;;

  discover)
    sid="${1:?storage-id}"; shift || true
    mode=true
    [[ "${1:-}" == "--all" ]] && mode=false
    # fail-fast: process substitution не пробрасывает exit rbv_discover в set -e
    rbv_storage_json "$sid" >/dev/null
    printf '%-6s %-50s %s\n' "KIND" "INSTANCE" "KEY"
    while IFS='|' read -r kind inst key parent; do
      printf '%-6s %-50s %s\n' "$kind" "$inst" "$key"
    done < <(rbv_discover "$sid" "$mode")
    ;;

  run)
    DUE=false; ONLY=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --due) DUE=true; shift ;;
        --storage) ONLY="$2"; shift 2 ;;
        *) msg ERR "unknown $1"; exit 1 ;;
      esac
    done
    if [[ "$DUE" == true ]]; then
      rbv_global_due || { msg INFO "Ещё не время (глобальное расписание)"; exit 0; }
    fi
    if [[ -n "$ONLY" ]]; then
      rbv_storage_json "$ONLY" >/dev/null
      while IFS='|' read -r kind inst key parent; do
        [[ -n "${key:-}" ]] || continue
        rbv_enqueue_instance "$ONLY" "$kind" "$inst" "$key" "$parent" "manual"
      done < <(rbv_discover "$ONLY" true)
    else
      rbv_enqueue_all_untested "$([[ $DUE == true ]] && echo schedule || echo manual)"
    fi
    "${SCRIPT_DIR}/rbv-worker.sh"
    [[ "$DUE" == true ]] && rbv_mark_global_done
    ;;

  queue)
    sub="${1:-status}"; shift || true
    case "$sub" in
      status)
        ls -1 "$(rbv_queue_dir)"/*.job 2>/dev/null || echo "(пусто)"
        ;;
      clear)
        rm -f "$(rbv_queue_dir)"/*.job
        msg OK "Очередь очищена"
        ;;
      work)
        exec "${SCRIPT_DIR}/rbv-worker.sh"
        ;;
      *) msg ERR "queue: status|clear|work"; exit 1 ;;
    esac
    ;;

  tick)
    if rbv_global_due; then
      rbv_enqueue_all_untested schedule
      "${SCRIPT_DIR}/rbv-worker.sh"
      rbv_mark_global_done
    fi
    ;;

  *)
    usage
    exit 1
    ;;
esac
